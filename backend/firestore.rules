rules_version = '2';

// Ready-to-apply Firestore security rules for when BIM Insight moves off the
// localStorage prototype onto Firebase. Paste into Firebase Console →
// Firestore → Rules. These lock the database down (the opposite of the
// dangerous `allow read, write: if true;` default).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users: a person can read/write only their own profile document.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Scripts: public can read only APPROVED scripts (moderation gate).
    // Authors can read their own regardless of status.
    // Only the authenticated author may create; new docs start as 'pending'.
    match /scripts/{scriptId} {
      allow read: if resource.data.status == 'approved'
                  || isOwner(resource.data.authorId);

      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.description is string
                    && request.resource.data.dynamoVersion is string
                    && request.resource.data.revitVersion is string;

      // Author can edit their own metadata but must NOT self-approve.
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.status == resource.data.status;

      allow delete: if isOwner(resource.data.authorId);
      // Approval (status -> 'approved') is performed by an admin via the
      // Admin SDK / a Cloud Function, which bypasses these client rules.
    }

    // Social: one like/rating doc per user per script; comments owned by author.
    match /scripts/{scriptId}/likes/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }
    match /scripts/{scriptId}/ratings/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5;
    }
    match /scripts/{scriptId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isOwner(resource.data.authorId);
    }
  }
}
